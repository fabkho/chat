{
  "name": "@fabkho/chat",
  "version": "0.1.0",
  "description": "A chat's client logic as a Nuxt layer: send queue, threads, spoiler veil, photo and GIF helpers and a Realtime core, framework-free behind an adapter. No words, no app imports, no Supabase.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabkho/chat.git"
  },
  "packageManager": "pnpm@12.16.1",
  "exports": {
    ".": "./nuxt.config.ts",
    "./*": "./*"
  },
  "main": "./nuxt.config.ts",
  "files": [
    "app",
    "nuxt.config.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@fabkho/ui": "*",
    "nuxt": "^4.5.2",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@fabkho/ui": "github:fabkho/ui#v0.10.6",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "vue": "3.5.44"
  }
}
