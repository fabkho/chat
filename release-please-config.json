{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "pull-request-header": "A release of @fabkho/chat. Merging this pull request tags it and creates the GitHub release; the apps then move their `\"@fabkho/chat\": \"github:fabkho/chat#vX.Y.Z\"` pin to the tag (`pnpm add -E github:fabkho/chat#vX.Y.Z`, so the lockfile follows).",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "revert", "section": "Reverts" },
    { "type": "docs", "section": "Docs", "hidden": true },
    { "type": "refactor", "section": "Refactoring", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true }
  ],
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "@fabkho/chat",
      "initial-version": "0.1.0",
      "changelog-path": "CHANGELOG.md",
      "draft": false,
      "prerelease": false
    }
  }
}
